# Full set of variables consumed by docker-compose.yml.
#
# mongo/backend load this file wholesale via `env_file: - .env` — every
# KEY=VALUE line here lands in their container environment as-is, no
# per-key list to keep in sync, no compose-level validation. The backend
# validates its own config at startup and fails fast on missing required
# fields (see internal/pkg/appconfig), so that's intentional there.
#
# web/web-public instead use explicit `${VAR:?...}`/`${VAR:-default}` in
# docker-compose.yml, because the Nuxt apps do no config validation of
# their own — required-ness has to be enforced at the compose level.
#
# Copy this file to `.env` next to docker-compose.yml (docker compose
# reads it automatically) and fill in real values. Never commit `.env`.

# ---------------------------------------------------------------------
# Compose-level (image tag, build args, host ports, log rotation) — not
# passed into containers, these still use ${VAR:-default} in the compose
# file itself, so they're optional here.
# ---------------------------------------------------------------------

# APP_VERSION/APP_VERSION_COMMIT are only used when building locally
# (`docker compose up --build`) — baked into the backend binary's version
# string, not the image tag. Unused on a deploy VM that only pulls.
APP_VERSION=dev
APP_VERSION_COMMIT=local

# Which published tag `docker compose pull`/`up` (without --build) uses
# for all three images — see .github/workflows/docker-publish.yml, which
# pushes one on every vX.Y.Z git tag. "latest" always tracks the newest
# tagged release; pin it (e.g. "v1.2.3") to control exactly what a `pull`
# picks up on the VM.
IMAGE_TAG=latest

WEB_PORT=3000
WEB_PUBLIC_PORT=3001

LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# ---------------------------------------------------------------------
# mongo container (fixed names required by the mongo:7 image itself).
# Must match MONGODB__CREDENTIALS__SCRAM__USERNAME/PASSWORD below — same
# credentials, two different variable names because one belongs to the
# mongo image and the other to the backend's own config.
# ---------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me

# ---------------------------------------------------------------------
# backend — gRPC/HTTP listeners.
# 0.0.0.0 binds inside the container; nothing is published to the host
# (see docker-compose.yml), only web/web-public reach these over the
# compose-internal network. Change only if you're changing the topology.
# ---------------------------------------------------------------------
GRPC__LISTEN_ADDRESS=0.0.0.0:7779
GRPC__REFLECTION=true
GRPC__LOG_REQUESTS=true
HTTP__LISTEN_ADDRESS=0.0.0.0:9080
HTTP__LOG_REQUESTS=true

# ---------------------------------------------------------------------
# backend — logger.
# ---------------------------------------------------------------------
LOGGER__LEVEL=info
LOGGER__OUTPUT_FORMAT=json
LOGGER__COLORIZED=false

# ---------------------------------------------------------------------
# backend — mongodb. MONGODB__HOSTS uses the compose service name
# "mongo", not a host address — only change it if you rename that
# service. USERNAME/PASSWORD must equal MONGO_INITDB_ROOT_* above.
# ---------------------------------------------------------------------
MONGODB__HOSTS=[mongo:27017]
MONGODB__DATABASE=my-business-crm
MONGODB__CREDENTIALS__AUTH_MECHANISM=SCRAM-SHA-256
MONGODB__CREDENTIALS__SCRAM__AUTH_SOURCE=admin
MONGODB__CREDENTIALS__SCRAM__USERNAME=admin
MONGODB__CREDENTIALS__SCRAM__PASSWORD=change-me
MONGODB__DIRECT_CONNECTION=true

# ---------------------------------------------------------------------
# backend — redis. Same "service name, not host address" note as mongo.
# ---------------------------------------------------------------------
REDIS__HOSTS=[redis:6379]
REDIS__DATABASE=0

NODE__ID=1

# ---------------------------------------------------------------------
# backend — observability.
# ---------------------------------------------------------------------
OBSERVABILITY__METRICS__ENABLED=true
OBSERVABILITY__METRICS__TYPE=prometheus
OBSERVABILITY__METRICS__SERVICE_NAME=my-business-crm

# ---------------------------------------------------------------------
# backend — auth. CRM__AUTH__SIGNING_KEY guards issued tokens; generate a
# real random value for any non-throwaway deployment.
# ---------------------------------------------------------------------
CRM__AUTH__SIGNING_KEY=change-me
CRM__AUTH__TOKEN_TTL=72h

# ---------------------------------------------------------------------
# backend — first admin account (internal/fx/bootstrap.go), created once
# on first boot only, if no user with this phone/email exists yet.
# ---------------------------------------------------------------------
CRM__BOOTSTRAP_ADMIN__NAME=Admin
CRM__BOOTSTRAP_ADMIN__PHONE=+000000000000
CRM__BOOTSTRAP_ADMIN__EMAIL=admin@example.com
CRM__BOOTSTRAP_ADMIN__PASSWORD=change-me-12345

# ---------------------------------------------------------------------
# backend — RBAC.
# ---------------------------------------------------------------------
CRM__RBAC__admin=*
CRM__RBAC__employee=products:read,products:create,categories:read,categories:create,brands:read,brands:create,sales:create

# ---------------------------------------------------------------------
# backend — product image storage. Matches the backend_images volume
# mount in docker-compose.yml regardless of how VAR_DIR is configured.
# ---------------------------------------------------------------------
CRM__IMAGES__DIR=/var/images

# ---------------------------------------------------------------------
# backend — outbound SMTP for NotificationsService.Send (web-public's
# contact/dealer forms) and the static API key web-public must present to
# call it (internal/transports/grpc/interceptors/clientkey). Both are
# optional (CRMConfig.Smtp / CRMConfig.NotificationClients) — but
# CRMConfig.Smtp.Validate requires every field once the smtp section
# exists at all, so leave all six commented out to keep form delivery
# disabled, or set all six to enable it.
# ---------------------------------------------------------------------
#CRM__SMTP__HOST=smtp.gmail.com
#CRM__SMTP__PORT=587
#CRM__SMTP__USERNAME=you@example.com
#CRM__SMTP__PASSWORD=change-me-before-boot
#CRM__SMTP__FROM=no-reply@example.com
#CRM__SMTP__TO=sales@example.com
# Must be the exact same value as NUXT_GRPC_CLIENT_KEY below — one is the
# backend's allow-list entry, the other is what web-public sends.
#CRM__NOTIFICATION_CLIENTS__web_public=change-me-before-boot
#NUXT_GRPC_CLIENT_KEY=change-me-before-boot

# ---------------------------------------------------------------------
# web (admin UI) / web-public (public site).
# ---------------------------------------------------------------------
NUXT_GRPC_BASE_URL=backend:7779
NUXT_GRPC_TIMEOUT_MS=15000
NUXT_IMAGES_BASE_URL=http://backend:9080
NUXT_IMAGES_MAX_SIZE_BYTES=10485760
NUXT_SESSION_SECRET=change-me
NUXT_SESSION_TTL_SECONDS=43200

# Link web-public's "account" icon points at. On a single-domain deployment
# where nginx proxies web (admin) under /admin/ on the same host as
# web-public (see web/nuxt.config.js app.baseURL), this must match that
# prefix — e.g. https://phomi.info/admin/login. A relative path also works
# as long as both apps share the same origin.
NUXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin/login
NUXT_PUBLIC_SITE_URL=http://localhost:3001
