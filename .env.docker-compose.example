# Variables used by docker-compose.yml for image tagging and container
# credentials. Copy relevant lines into the root .env (docker compose reads
# it automatically) or pass with `docker compose --env-file`.
# These are separate from the app's own CRM_/GRPC__/... runtime config keys.

APP_VERSION=dev
APP_VERSION_COMMIT=local

MONGO_ROOT_USER=admin
MONGODB_DATABASE=my-business-crm

REDIS_DATABASE=0

NODE_ID=1
LOGGER_LEVEL=info

# Required — compose fails fast without these. mongo/redis/backend no
# longer publish ports to the host (see docker-compose.yml), but the
# Mongo credentials still guard anything on the same docker network, so
# MONGO_ROOT_PASSWORD is required rather than silently defaulting.
CRM_SIGNING_KEY=change-me
CRM_BOOTSTRAP_ADMIN_PASSWORD=change-me-12345
CRM_BOOTSTRAP_ADMIN_NAME=Admin
CRM_BOOTSTRAP_ADMIN_PHONE=+000000000000
CRM_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
MONGO_ROOT_PASSWORD=change-me

NUXT_SESSION_SECRET=change-me

# Outbound SMTP for NotificationsService.Send (web-public/'s contact/dealer
# forms) and the static API key web-public must present to call it
# (internal/transports/grpc/interceptors/clientkey). Both are optional on
# the backend (CRMConfig.Smtp / CRMConfig.NotificationClients) — but
# CRMConfig.Smtp.Validate requires every field once the smtp section
# exists at all, so docker-compose.yml passes these through only when set
# (bare `- CRM__SMTP__HOST` entries, no `:-` default) rather than mapping
# them to an always-present empty string, which would make the section
# "exist" with blank required fields and fail app boot. Leave commented
# out to keep form delivery disabled; uncomment and fill in to enable.
#CRM__SMTP__HOST=smtp.gmail.com
#CRM__SMTP__PORT=587
#CRM__SMTP__USERNAME=you@example.com
#CRM__SMTP__PASSWORD=change-me-before-boot
#CRM__SMTP__FROM=no-reply@example.com
#CRM__SMTP__TO=sales@example.com
# Must be the exact same value as NUXT_GRPC_CLIENT_KEY below — one is the
# backend's allow-list entry, the other is what web-public sends.
#CRM__NOTIFICATION_CLIENTS__web_public=change-me-before-boot
#NUXT_GRPC_CLIENT_KEY=change-me-before-boot

NUXT_PUBLIC_ADMIN_URL=http://localhost:3000/login
NUXT_PUBLIC_SITE_URL=http://localhost:3001
