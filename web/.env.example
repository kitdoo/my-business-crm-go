# gRPC backend (configs/grpc.yaml on the Go service)
NUXT_GRPC_BASE_URL=127.0.0.1:7777
NUXT_GRPC_TIMEOUT_MS=15000

# HTTP backend, only used server-side for /images passthrough (TD §4.6)
NUXT_IMAGES_BASE_URL=http://127.0.0.1:9080
NUXT_IMAGES_MAX_SIZE_BYTES=10485760

# Session cookie signing / TTL
NUXT_SESSION_SECRET=change-me
NUXT_SESSION_TTL_SECONDS=43200
