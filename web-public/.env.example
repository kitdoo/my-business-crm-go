# gRPC backend (same backend as web/, configs/grpc.yaml on the Go service).
# ProductsService.List / PricesService.Get / CategoriesService.List are
# anonymous on the backend (see internal/transports/grpc/interceptors/auth)
# — no credentials needed here, the catalog BFF calls them unauthenticated.
NUXT_GRPC_BASE_URL=127.0.0.1:7779
NUXT_GRPC_TIMEOUT_MS=15000

# HTTP backend, only used server-side for /api/images passthrough.
NUXT_IMAGES_BASE_URL=http://127.0.0.1:9080

# Forms (stub for this iteration — see server/utils/submitForm.js).
NUXT_MAIL_SMTP_URL=
NUXT_MAIL_CONTACT_RECIPIENT=

# Public
NUXT_PUBLIC_ADMIN_URL=http://localhost:3000/login
NUXT_PUBLIC_SITE_URL=https://phomi.rs
